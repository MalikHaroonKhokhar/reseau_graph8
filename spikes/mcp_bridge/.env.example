# --- GitHub remote MCP (https://api.githubcopilot.com/mcp/) ---
# Accepts a GitHub PAT as a bearer token. Fine-grained PAT, read-only:
# Repository: Contents/Issues/Pull requests/Metadata = Read. No write scopes needed for this test.
GITHUB_MCP_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: read-only server variant, or a single toolset (smaller tool list)
# GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/readonly

# --- Linear remote MCP (https://mcp.linear.app/mcp) ---
# Accepts a Linear API key or an OAuth access token as a bearer token (verified, see FINDINGS.md Run 2).
LINEAR_MCP_TOKEN=lin_api_xxxxxxxxxxxxxxxxxxxx
# LINEAR_MCP_URL=http://127.0.0.1:8080/mcp

# --- Graph8 side (only needed to test Graph8's own MCP client / agent run) ---
GRAPH8_API_URL=https://be.graph8.com/mcp/
GRAPH8_API_KEY=
