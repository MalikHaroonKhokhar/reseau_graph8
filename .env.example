GITHUB_MCP_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxxxxxx
GRAPH8_API_KEY=g8_live_xxxxxxxxxxxxxxxx
# python -c 'import secrets; print(secrets.token_urlsafe(32))'; comma-separate to rotate
RESEAU_GATEWAY_TOKEN=
# optional: JSON map of people to upstream IDs, {"ana": {"github": "<login>", "linear": "<Linear user id>"}}
RESEAU_IDENTITIES=
# optional: JSON map of projects, {"app": {"linear": "<Linear project>", "repos": ["owner/repo"]}}; repos inside the scope below
RESEAU_PROJECTS=
# optional: the Linear team (name, key or ID) get_team_summary covers
RESEAU_TEAM=
# optional: IANA timezone for the semantic tools' days ("yesterday", get_person_activity's date); default UTC
RESEAU_TIMEZONE=
# GitHub owners (users/orgs) and owner/repo entries the gateway may read, comma-separated: raw github_* tools,
# get_evidence and the semantic tools. A user entry covers only repos that account owns, not its orgs'.
# Unset = no GitHub repo is read.
RESEAU_GITHUB_SCOPE=
# the Start My Day workflow's action_id, printed by `python -m reseau.workflows setup`
RESEAU_START_MY_DAY=
# the daily report workflow's action_id, printed by the same `setup`
RESEAU_DAILY_REPORT=
